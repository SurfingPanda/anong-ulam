# ---------------------------------------------------------------------------
# Supabase — copy this file to ".env.local" and fill in the values.
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (server-only, NEVER exposed to the browser). Needed to
# persist AI-generated dishes back into the catalog (supabase/ai-persistence.md)
# AND for the nightly commodity-price refresh (supabase/market-prices.md).
# Leave unset to keep AI dishes ephemeral and prices as hardcoded estimates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Live ingredient prices (OPTIONAL) — see supabase/market-prices.md
# A Vercel Cron (vercel.json) hits /api/cron/refresh-prices nightly to pull
# DA "Bantay Presyo" wet-market prices into the `market_prices` table.
# Set CRON_SECRET to any random string; Vercel sends it as a Bearer token on
# cron requests, and you pass the same to trigger a refresh by hand.
# Leave unset locally — the overlay just no-ops and estimates are used.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Google Gemini (OPTIONAL, free tier) — powers the AI fallback in
# app/actions/generate-ulam.ts when the database returns few/no matches.
# To enable: npm i ai @ai-sdk/google@ai-v6 zod
# Get a free key at https://aistudio.google.com/apikey
# Leave unset to use the built-in low-cost default suggestions instead.
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
