# ---------------------------------------------------------------------------
# Supabase — copy this file to ".env.local" and fill in the values.
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Google Gemini (OPTIONAL, free tier) — powers the AI fallback in
# app/actions/generate-ulam.ts when the database returns few/no matches.
# To enable: npm i ai @ai-sdk/google@ai-v6 zod
# Get a free key at https://aistudio.google.com/apikey
# Leave unset to use the built-in low-cost default suggestions instead.
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
